      "enum": [
        "T",
        "F",
        "U"
      ]
    },
    "Flag": {
      "type": "boolean"
    },
    "Count": {
      "description": "An integer within ±2^53.",
      "type": "integer",
      "minimum": -9007199254740992,
      "maximum": 9007199254740992
    },
    "Digest": {
      "description": "sha256: and 64 lowercase hex digits.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "String": {
