{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/due2/schema/1/normaliser.schema.json",
  "x-version": "1.0",
  "title": "due2 normaliser port",
  "description": "The output of normalise (due2-platform.md §2.8, due2-workflows.md §4): a corpus and its lineage, or a rejection. Generated by tools/gen_schema.py; see schema/README.md.",
  "$defs": {
    "Rejection": {
      "description": "The run's diagnostics, at least one an error (due2-diagnostics.md §1).",
      "type": "object",
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "collections.schema.json#/$defs/Diagnostic"
          },
          "contains": {
            "properties": {
              "severity": {
                "const": "error"
              }
            }
          }
        }
      },
      "required": [
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "NormaliseOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "corpus": {
              "$ref": "collections.schema.json#/$defs/Corpus"
            },
            "lineage": {
              "$ref": "collections.schema.json#/$defs/Lineage"
            }
          },
          "required": [
            "corpus",
            "lineage"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/Rejection"
        }
      ]
    }
  }
}
