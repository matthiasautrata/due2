@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix ex:    <https://example.org/> .

# Source: RL2 conformance/usecases/display-vs-nondisplay.md

ex:displayLicence a odrl:Agreement ;
    odrl:conflict odrl:prohibit ;
    odrl:assigner ex:Vendor ;
    odrl:assignee ex:Subscriber ;
    odrl:target ex:QuotationFeed ;
    odrl:permission ex:displayQuotation ;
    odrl:prohibition ex:noAutomatedTrading .

ex:displayQuotation a odrl:Permission ;
    odrl:action ex:display .

ex:noAutomatedTrading a odrl:Prohibition ;
    odrl:action ex:automatedTrade .

# IM 2.4: an action other than use and transfer is included in exactly one other;
# the source names none for these, so odrl:use, the broadest.
ex:display a odrl:Action ; odrl:includedIn odrl:use .
ex:automatedTrade a odrl:Action ; odrl:includedIn odrl:use .
