@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix due2:  <https://w3id.org/due2/profile#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix ex:    <https://example.org/> .

# due2-native: a refinement on a policy-level action is read in its own policy's
# data space (decisions/0050 #1, #7). The offer's one action, use for research,
# is stated on the policy, and normalisation gives it to ex:useA
# (odrl-compound-to-atomic-normalization.md §6.2). In the offer's scheme,
# dpv:ScientificResearch is below dpv:Research and dpv:Marketing is not. The
# other policy is in policy-partner.ttl.

ex:offer a odrl:Set ;
    odrl:profile <https://w3id.org/due2/profile#> ;
    odrl:conflict odrl:prohibit ;
    odrl:action [
        rdf:value odrl:use ;
        odrl:refinement [
            a odrl:Constraint ;
            odrl:leftOperand odrl:purpose ;
            odrl:operator odrl:eq ;
            odrl:rightOperand dpv:Research
        ]
    ] ;
    odrl:permission ex:useA .

ex:useA a odrl:Permission ;
    odrl:target ex:a .

odrl:purpose due2:conceptScheme dpv:purposes-classes .

dpv:purposes-classes a skos:ConceptScheme ;
    skos:hasTopConcept dpv:Research, dpv:Marketing .
dpv:Research a skos:Concept ; skos:narrower dpv:ScientificResearch .
dpv:ScientificResearch a skos:Concept ; skos:inScheme dpv:purposes-classes .
dpv:Marketing a skos:Concept .
