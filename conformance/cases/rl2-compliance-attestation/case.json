{
  "case": "rl2-compliance-attestation",
  "source": "RL2 conformance/usecases/compliance-attestation.md",
  "classification": "odrl-core",
  "needs": [],
  "notes": "Direct translation. The agent-scoped attested fact agent.complianceStatus becomes the state property ex:requesterComplianceStatus with range compliance:Status (a class range: the value must be an IRI). RL2 filters candidates by validity interval and by the configured admissibility record before resolving. due2 now has the same filter in configuration (admit_source, admit_age; due2-workflows.md §3.4), but the case format gives facts no attribution (source, observed_at), so a scenario cannot show the filter at work; scenario 3 therefore shows its result — the assembler-filtered property reported missing — which is also how RL2 resolves it. The RL2 text states Indeterminate for missing, inadmissible, and conflicting data; scenarios 2–4 carry those. Scenario 5 is added.",
  "prefixes": { "ex": "https://example.org/", "compliance": "https://example.org/profile/compliance#" },
  "scenarios": [
    {
      "name": "admissible attestation: certified",
      "request": {
        "reference": "req-1", "action": "ex:process", "target": "ex:SensitiveDataset", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Processor" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requesterComplianceStatus": { "status": "resolved", "values": [ { "@id": "compliance:Certified" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Permit", "frontier": [], "obligations": [], "why": "Assignee, action, and target match and the status is compliance:Certified, so ex:certifiedProcessing applies with no duties." },
      "rl2_expected": "Permit"
    },
    {
      "name": "attestation missing",
      "request": {
        "reference": "req-2", "action": "ex:process", "target": "ex:SensitiveDataset", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Processor" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requesterComplianceStatus": { "status": "missing", "values": [] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Indeterminate", "frontier": [], "obligations": [], "why": "The status is missing, so the constraint and the permission are U. Completions give Permit and NotApplicable." },
      "rl2_expected": "Indeterminate"
    },
    {
      "name": "attestation from an issuer the profile does not accept",
      "request": {
        "reference": "req-3", "action": "ex:process", "target": "ex:SensitiveDataset", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Processor" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requesterComplianceStatus": { "status": "missing", "values": [] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Indeterminate", "frontier": [], "obligations": [], "why": "An inadmissible value is treated as absent (due2-profiles.md §3), so the property is missing and the permission U. Completions give Permit and NotApplicable." },
      "rl2_expected": "Indeterminate"
    },
    {
      "name": "conflicting attestations",
      "request": {
        "reference": "req-4", "action": "ex:process", "target": "ex:SensitiveDataset", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Processor" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requesterComplianceStatus": { "status": "conflict", "values": [ { "@id": "compliance:Certified" }, { "@id": "compliance:Suspended" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Indeterminate", "frontier": [], "obligations": [], "why": "Two distinct values for a cardinality-one property are a conflict, so the constraint is U. Completions give Permit and NotApplicable." },
      "rl2_expected": "Indeterminate"
    },
    {
      "name": "attested as suspended",
      "request": {
        "reference": "req-5", "action": "ex:process", "target": "ex:SensitiveDataset", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Processor" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requesterComplianceStatus": { "status": "resolved", "values": [ { "@id": "compliance:Suspended" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "NotApplicable", "frontier": [], "obligations": [], "why": "compliance:Suspended eq compliance:Certified is F, so the permission does not apply." }
    }
  ]
}
