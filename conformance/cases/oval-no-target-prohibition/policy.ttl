@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

# Source: DIPS-Tools/ODRL-Engine@40b8ac6 test_cases/evaluation/access_control/
# default_sem4-6.ttl and prohibition1-3.ttl (MIT, University of Southampton) — one policy.
# Changes: rule named; conflict declared.

<http://example.com/policy:1010> a odrl:Set ;
    odrl:conflict odrl:prohibit ;
    odrl:prohibition <http://example.com/policy:1010#prohibition> .

<http://example.com/policy:1010#prohibition> a odrl:Prohibition ;
    odrl:action odrl:use ;
    odrl:target <http://example.com/asset:9898.movie> .
