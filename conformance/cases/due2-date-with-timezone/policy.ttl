@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix due2:  <https://w3id.org/due2/profile#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# A negative case: valid ODRL 2.2, rejected by due2. ex:publicationDate has the
# range xsd:date, and the right operand is a date with a timezone. due2 admits a
# date only without one, so that dates are totally ordered (due2-profiles.md §4,
# decisions/0024).

ex:licencePolicy a odrl:Set ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/>, <https://w3id.org/due2/profile#> ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:display .

ex:display a odrl:Permission ;
    odrl:action odrl:display ;
    odrl:target ex:Report ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:publicationDate ;
        odrl:operator odrl:lteq ;
        odrl:rightOperand "2026-12-31+01:00"^^xsd:date
    ] .

ex:publicationDate a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:publishedOn ;
    rdfs:range xsd:date .
