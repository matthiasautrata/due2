@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix ex:   <https://example.org/> .

# A negative case: valid ODRL 2.2, rejected by due2. The assignee names the
# Agreement with odrl:assigneeOf, and no Rule names an assignee. ODRL IM §2.3.3
# and the vocabulary's note on odrl:assigneeOf: the party "MUST be inferred to
# undertake the assignee functional role of all the Rules of that Policy", so
# only ex:alice may read. W1 infers nothing beyond the declared edges, so it
# would see a permission with no assignee, which any requester matches:
# due2-workflows.md §5.2 builds a party part only for a party the atom names.

ex:alice odrl:assigneeOf ex:agreement .

ex:agreement a odrl:Agreement ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:read .

ex:read a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:dataset ;
    odrl:assigner ex:acme .
