@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# Source: RL2 conformance/usecases/no-redistribution.md

ex:marketDataAgreement a odrl:Agreement ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:conflict odrl:prohibit ;
    odrl:assigner ex:Vendor ;
    odrl:assignee ex:Bank ;
    odrl:prohibition ex:noRedistribution .

ex:noRedistribution a odrl:Prohibition ;
    odrl:action ex:redistribute ;
    odrl:target ex:MarketData ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:requiredDisclosure ;
        odrl:operator odrl:eq ;
        odrl:rightOperand false
    ] .

# IM 2.4: an action other than use and transfer is included in exactly one other;
# the source names none for these, so odrl:use, the broadest.
ex:redistribute a odrl:Action ; odrl:includedIn odrl:use .

# RL2 path context.requiredDisclosure, flattened onto the state node.
ex:requiredDisclosure a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:requiredDisclosure ;
    rdfs:range xsd:boolean .
