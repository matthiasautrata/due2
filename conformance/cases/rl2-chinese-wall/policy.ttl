@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# Source: RL2 conformance/usecases/chinese-wall.md

ex:informationBarrierPolicy a odrl:Set ;
    odrl:conflict odrl:prohibit ;
    odrl:prohibition ex:unpublishedReportProhibition ;
    odrl:permission ex:publishedReportPrivilege , ex:analystReadPrivilege .

ex:unpublishedReportProhibition a odrl:Prohibition ;
    odrl:assignee ex:InvestmentBanker ;
    odrl:action ex:read ;
    odrl:target ex:ResearchReport ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:reportPublished ;
        odrl:operator odrl:eq ;
        odrl:rightOperand false
    ] .

ex:publishedReportPrivilege a odrl:Permission ;
    odrl:assignee ex:InvestmentBanker ;
    odrl:action ex:read ;
    odrl:target ex:ResearchReport ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:reportPublished ;
        odrl:operator odrl:eq ;
        odrl:rightOperand true
    ] .

ex:analystReadPrivilege a odrl:Permission ;
    odrl:assignee ex:ResearchAnalyst ;
    odrl:action ex:read ;
    odrl:target ex:ResearchReport .

ex:read a odrl:Action .

# RL2 path asset.publication.published, flattened onto the state node for the requested asset.
ex:reportPublished a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:targetPublished ;
    rdfs:range xsd:boolean .
