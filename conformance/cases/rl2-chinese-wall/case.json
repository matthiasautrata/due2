      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Deny", "frontier": [], "obligations": [], "why": "ex:unpublishedReportProhibition applies (false eq false). ex:publishedReportPrivilege is F (false eq true) and ex:analystReadPrivilege is F on assignee. A T Forbid survives, so Deny." },
      "rl2_expected": "Deny"
    },
