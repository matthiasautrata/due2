@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

# Source: DIPS-Tools/ODRL-Engine@40b8ac6 test_cases/evaluation/access_control/conflict3.ttl
# (MIT, University of Southampton). Rules named. The prohibition's target, which
# IM 2.6.2 requires, was absent at f0839f6 and was added upstream in 531edf1.

<http://example.com/policy:1010> a odrl:Set ;
    odrl:conflict odrl:invalid ;
    odrl:prohibition <http://example.com/policy:1010#prohibition> ;
    odrl:permission <http://example.com/policy:1010#permission> .

<http://example.com/policy:1010#prohibition> a odrl:Prohibition ;
    odrl:action odrl:use ;
    odrl:assignee <http://example.com/party:Bob> ;
    odrl:target <http://example.com/asset:9898.movie> .

<http://example.com/policy:1010#permission> a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target <http://example.com/asset:9898.movie> .
