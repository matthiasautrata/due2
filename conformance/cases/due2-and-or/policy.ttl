@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# A negative case: one logical constraint with both odrl:and and odrl:or.
# ODRL IM §2.5.2: a logical constraint has exactly one operand property. With
# two, nothing says how they combine. Read as their conjunction, the constraint
# is ex:fromStart and ex:untilEnd; read as their disjunction, ex:fromStart or
# ex:untilEnd. The readings differ for a report published on 2027-03-01 (#117).

ex:licencePolicy a odrl:Set ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:display .

ex:display a odrl:Permission ;
    odrl:action odrl:display ;
    odrl:target ex:Report ;
    odrl:constraint ex:window .

ex:window a odrl:LogicalConstraint ;
    odrl:and ( ex:fromStart ex:untilEnd ) ;
    odrl:or ( ex:fromStart ex:untilEnd ) .

ex:fromStart a odrl:Constraint ;
    odrl:leftOperand ex:publicationDate ;
    odrl:operator odrl:gteq ;
    odrl:rightOperand "2026-01-01"^^xsd:date .

ex:untilEnd a odrl:Constraint ;
    odrl:leftOperand ex:publicationDate ;
    odrl:operator odrl:lteq ;
    odrl:rightOperand "2026-12-31"^^xsd:date .

ex:publicationDate a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:publishedOn ;
    rdfs:range xsd:date .
