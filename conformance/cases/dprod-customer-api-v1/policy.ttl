@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .
@prefix offer: <https://example.org/offers/> .
@prefix agent: <https://example.org/agents/> .
@prefix asset: <https://example.org/assets/> .
@prefix rule:  <https://example.org/rules/> .

# Source: DPROD Contracts dprod-contracts/examples/baseline.ttl,
# policy <https://example.org/offers/customer-api-v1> (EKGF dprod, develop, 50db943).

offer:customer-api-v1 a dprod:DataOffer ;
    rdfs:label "Customer API v1 (retired)" ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:assigner agent:data-platform ;
    odrl:target asset:customer-data ;
    dprod:offerLifecycleStatus dprod:Fulfilled ;
    prov:wasRevisionOf offer:customer-api-v2 ;
    odrl:permission rule:v1-use .

rule:v1-use a odrl:Permission ;
    rdfs:label "Use" ;
    odrl:action odrl:use .

agent:data-platform a odrl:Party ; rdfs:label "Data Platform Team" .
asset:customer-data a odrl:Asset ; rdfs:label "Customer Data" .
