@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# Source: RL2 conformance/usecases/legal-review-gate.md

ex:customerDataAgreement a odrl:Agreement ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:conflict odrl:prohibit ;
    odrl:assigner ex:Customer ;
    odrl:assignee ex:Vendor ;
    odrl:permission ex:approvedVendorAccess .

ex:approvedVendorAccess a odrl:Permission ;
    odrl:action ex:access ;
    odrl:target ex:CustomerData ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:legalReviewApproved ;
        odrl:operator odrl:eq ;
        odrl:rightOperand true
    ] .

ex:access a odrl:Action .

# RL2 path global.legalReview.approved, flattened onto the state node.
ex:legalReviewApproved a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:legalReviewApproved ;
    rdfs:range xsd:boolean .
