        "reference": "req-1a",
        "action": "odrl:distribute",
        "target": "ex:ListedExport",
        "at": "2026-06-01T12:00:00Z",
        "parties": {
          "odrl:assignee": "ex:Dana"
        },
        "params": {
          "ex:package": [
            {
              "@id": "ex:SalesData"
            },
            {
              "@id": "ex:HRData"
            }
          ]
        }
      },
      "sotw": {
        "effective_at": "2026-06-01T12:00:00Z",
        "facts": {},
        "evidence": [],
        "activation": {},
        "closure": []
      },
      "expected": {
        "verdict": "Permit",
        "frontier": [],
        "obligations": [],
        "verdict_basis": [
          {
            "ref": "ex:exportListed",
            "role": "permission"
          }
        ],
        "eliminated": [],
        "why": "ex:SalesQ1 is part of ex:SalesData through ex:SalesFY26, and ex:HRSummary is part of ex:HRData, so every value of {ex:SalesQ1, ex:HRSummary} is part of some package value: hasPart is T and ex:exportListed applies. Nothing prohibits, so Permit."
      }
    },
