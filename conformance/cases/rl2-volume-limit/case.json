{
  "case": "rl2-volume-limit",
  "source": "RL2 conformance/usecases/volume-limit.md",
  "classification": "odrl-core",
  "needs": [],
  "notes": "Direct translation. rl2:Privilege → odrl:Permission; the request parameter becomes a requestSource operand and the quota admission fact a stateSource operand. Policy-level assignee replaces RL2's rl2:subject on the clause (compact policy). The RL2 rl2:and logical constraint becomes two rule constraints, which ODRL reads conjunctively. Scenarios 2 and 3 are added.",
  "prefixes": { "ex": "https://example.org/" },
  "scenarios": [
    {
      "name": "within ceiling and quota",
      "request": {
        "reference": "req-1",
        "action": "ex:retrieve",
        "target": "ex:DataService",
        "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Subscriber" },
        "params": { "ex:requestedRecords": { "@value": "12000", "@type": "xsd:integer" } }
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requestedWithinRemaining": { "status": "resolved", "values": [ { "@value": "true", "@type": "xsd:boolean" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Permit", "frontier": [], "obligations": [], "why": "12000 ≤ 20000 and the quota fact is true, so ex:limitedRetrieval applies; it has no duties and nothing prohibits." },
      "rl2_expected": "Permit"
    },
    {
      "name": "above the per-request ceiling",
      "request": {
        "reference": "req-2",
        "action": "ex:retrieve",
        "target": "ex:DataService",
        "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Subscriber" },
        "params": { "ex:requestedRecords": { "@value": "25000", "@type": "xsd:integer" } }
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requestedWithinRemaining": { "status": "resolved", "values": [ { "@value": "true", "@type": "xsd:boolean" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "NotApplicable", "frontier": [], "obligations": [], "why": "25000 ≤ 20000 is F, so the permission does not apply; no other rule applies." }
    },
    {
      "name": "quota fact unavailable",
      "request": {
        "reference": "req-3",
        "action": "ex:retrieve",
        "target": "ex:DataService",
        "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:Subscriber" },
        "params": { "ex:requestedRecords": { "@value": "12000", "@type": "xsd:integer" } }
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:requestedWithinRemaining": { "status": "unresolved", "values": [] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "config": { "combination": "prohibit-overrides" },
      "expected": { "verdict": "Indeterminate", "frontier": [], "obligations": [], "why": "The ceiling holds but the quota constraint is U, so the permission is U. The permissive completion gives Permit and the restrictive one NotApplicable, so the verdict is not invariant." }
    }
  ]
}
