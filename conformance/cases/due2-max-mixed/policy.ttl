@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.com/> .

# Authored for due2 to exercise the max_mixed bound of workflows §6.4
# (decisions/0003 rebuilt it; the former nine-guard case is due2-conditional-duties).
# Nine regional entitlements, each written by its author as a complementary pair:
# members of desk i may read; non-members of desk i may read too. Each flag is a
# fact read in both directions, so with the flag unknown it is a mixed variable.
# Pair 1's member route carries an approval duty, so a known flag 1 leaves a
# pending route and the remaining eight decide the verdict only by enumeration.

<http://example.com/policy:MM> a odrl:Set ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:conflict odrl:prohibit ;
    odrl:permission <http://example.com/policy:MM#member-1>,
        <http://example.com/policy:MM#other-1>,
        <http://example.com/policy:MM#member-2>,
        <http://example.com/policy:MM#other-2>,
        <http://example.com/policy:MM#member-3>,
        <http://example.com/policy:MM#other-3>,
        <http://example.com/policy:MM#member-4>,
        <http://example.com/policy:MM#other-4>,
        <http://example.com/policy:MM#member-5>,
        <http://example.com/policy:MM#other-5>,
        <http://example.com/policy:MM#member-6>,
        <http://example.com/policy:MM#other-6>,
        <http://example.com/policy:MM#member-7>,
        <http://example.com/policy:MM#other-7>,
        <http://example.com/policy:MM#member-8>,
        <http://example.com/policy:MM#other-8>,
        <http://example.com/policy:MM#member-9>,
        <http://example.com/policy:MM#other-9> .

<http://example.com/policy:MM#member-1> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember1 ; odrl:operator odrl:eq ; odrl:rightOperand true ] ;
    odrl:duty <http://example.com/policy:MM#approval> .

<http://example.com/policy:MM#other-1> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember1 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-2> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember2 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-2> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember2 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-3> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember3 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-3> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember3 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-4> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember4 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-4> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember4 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-5> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember5 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-5> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember5 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-6> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember6 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-6> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember6 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-7> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember7 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-7> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember7 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-8> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember8 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-8> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember8 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#member-9> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember9 ; odrl:operator odrl:eq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#other-9> a odrl:Permission ;
    odrl:action odrl:read ;
    odrl:target ex:research ;
    odrl:constraint [ a odrl:Constraint ;
        odrl:leftOperand ex:deskMember9 ; odrl:operator odrl:neq ; odrl:rightOperand true ] .

<http://example.com/policy:MM#approval> a odrl:Duty ;
    odrl:assignee ex:party\/manager ;
    odrl:action ex:approve ;
    odrl:target ex:access-request .

# IM 2.4: an action other than use and transfer is included in exactly one other;
# the source names none for these, so odrl:use, the broadest.
ex:approve a odrl:Action ; odrl:includedIn odrl:use .

ex:deskMember1 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember1 ;
    rdfs:range xsd:boolean .

ex:deskMember2 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember2 ;
    rdfs:range xsd:boolean .

ex:deskMember3 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember3 ;
    rdfs:range xsd:boolean .

ex:deskMember4 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember4 ;
    rdfs:range xsd:boolean .

ex:deskMember5 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember5 ;
    rdfs:range xsd:boolean .

ex:deskMember6 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember6 ;
    rdfs:range xsd:boolean .

ex:deskMember7 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember7 ;
    rdfs:range xsd:boolean .

ex:deskMember8 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember8 ;
    rdfs:range xsd:boolean .

ex:deskMember9 a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:deskMember9 ;
    rdfs:range xsd:boolean .
