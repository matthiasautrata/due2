      "sotw": {
        "effective_at": "2026-01-01T00:00:00Z",
        "facts": {},
        "evidence": [],
        "activation": {},
        "closure": []
      },
      "expected": {
        "verdict": "Indeterminate",
        "frontier": [],
        "obligations": [],
        "verdict_range": {
          "low": "NotApplicable",
          "high": "Permit"
        },
        "unknown_parts": [
          {
            "ref": "ex:show",
            "input": "ex:displayHours",
            "status": "misfit"
          }
        ],
        "why": "As for 4: an unchecked unit makes the constraint U whatever value is read, so 12 does not make it F. Indeterminate, NotApplicable..Permit."
      }
    }
