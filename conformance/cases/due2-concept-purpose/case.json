      "name": "direct marketing, under marketing",
      "request": {
        "reference": "req",
        "action": "odrl:read",
        "target": "ex:CustomerData",
        "at": "2026-10-17T10:00:00Z",
        "parties": {},
        "params": {
          "odrl:purpose": {
            "@id": "dpv:DirectMarketing"
          }
        }
      },
      "sotw": {
        "effective_at": "2026-10-17T10:00:00Z",
        "facts": {},
        "evidence": [],
        "activation": {},
        "closure": []
      },
      "config": {
        "combination": "prohibit-overrides"
      },
      "expected": {
        "verdict": "Permit",
        "frontier": [],
        "obligations": [],
        "verdict_basis": [
          {
            "ref": "ex:readForMarketing",
            "role": "permission"
          }
        ],
        "eliminated": [],
        "unknown_parts": [],
        "why": "dpv:DirectMarketing skos:broader dpv:Marketing, so DirectMarketing ⊑ Marketing and the purpose constraint is T (due2-profiles.md §4). The permission applies and has no duties: Permit."
      }
    },
