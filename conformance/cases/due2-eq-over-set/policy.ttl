@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix due2:  <https://w3id.org/due2/profile#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# A negative case: valid ODRL 2.2, rejected by due2. ex:held is set-valued, and eq
# compares one value. "Holds the clearance" is written hasPart (due2-profiles.md §4,
# decisions/0025).

ex:licencePolicy a odrl:Set ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/>, <https://w3id.org/due2/profile#> ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:display .

ex:display a odrl:Permission ;
    odrl:action odrl:display ;
    odrl:target ex:Report ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:held ;
        odrl:operator odrl:eq ;
        odrl:rightOperand ex:Clearance
    ] .

ex:held a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:certifications ;
    due2:cardinality due2:set .
