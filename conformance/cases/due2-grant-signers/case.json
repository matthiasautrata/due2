        "evidence": [
          {
            "id": "ev-pay",
            "occurred_at": "2026-06-01T11:58:00Z",
            "actor": "ex:Alice",
            "action": "ex:pay",
            "object": "ex:ReportFee",
            "discharges": {
              "duty": "ex:payPerUse",
              "reference": "req-7"
            }
          }
        ],
        "activation": {},
        "closure": []
      },
      "expected": {
        "verdict": "Pending",
        "frontier": [
          [
            "ex:payPerUse"
          ]
        ],
        "obligations": [],
        "why": "The duty has an attester, so evidence with no issuer counts for nothing (§5.3). Outstanding."
      }
    },
    {
      "name": "request without a reference falls back to member scope",
      "request": {
        "action": "ex:downloadReport",
        "target": "ex:MarketReport",
        "at": "2026-06-01T12:00:00Z",
        "parties": {
          "odrl:assignee": "ex:Alice"
        },
        "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T12:00:00Z",
        "facts": {},
        "evidence": [
          {
            "id": "ev-pay",
            "occurred_at": "2026-06-01T11:58:00Z",
            "actor": "ex:Alice",
            "action": "ex:pay",
            "object": "ex:ReportFee",
            "issuer": "ex:Bank"
          }
        ],
        "activation": {},
        "closure": []
      },
      "expected": {
        "verdict": "Permit",
        "frontier": [],
        "obligations": [],
        "why": "With no request.reference a grant-scoped duty falls back to member scope (§5.3): discharges is not consulted, and ev-pay — the bearer's bank-attested pay on the fee — witnesses the member instance."
      }
    }
  ]
}