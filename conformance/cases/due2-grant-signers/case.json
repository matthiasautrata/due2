            "object": "ex:ReportFee",
            "discharges": {
              "duty": "ex:payPerUse",
              "reference": "req-7"
            }
          }
        ],
        "activation": {},
        "closure": []
      },
      "config": {
        "combination": "prohibit-overrides",
        "signers": [
          {
            "duty": "ex:payPerUse",
            "issuer": "ex:Bank"
          }
        ]
      },
      "expected": {
        "verdict": "Pending",
        "frontier": [
          [
            "ex:payPerUse"
          ]
        ],
        "obligations": [],
        "why": "The duty has signer entries, so evidence without an issuer counts for nothing (§3.4). Outstanding."
      }
    },
    {
      "name": "request without a reference falls back to member scope",
      "request": {
        "action": "ex:downloadReport",
        "target": "ex:MarketReport",
        "at": "2026-06-01T12:00:00Z",
        "parties": {
          "odrl:assignee": "ex:Alice"
        },
        "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T12:00:00Z",
