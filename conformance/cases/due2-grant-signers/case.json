      "config": {
        "combination": "prohibit-overrides",
        "signers": [
          {
            "duty": "ex:payPerUse",
            "issuer": "ex:Bank"
          }
        ]
      },
      "expected": {
        "verdict": "Permit",
        "frontier": [],
        "obligations": [],
        "why": "With no request.reference a grant-scoped duty falls back to member scope (§5.3): discharges is not consulted, and ev-pay — the bearer's bank-attested pay on the fee — witnesses the member instance."
      }
    }
  ]
}