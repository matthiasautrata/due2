@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix due2: <https://w3id.org/due2/profile#> .
@prefix ex:   <https://example.org/> .

# due2-native: pay per download, payment attested by the bank.
# Exercises grant-scoped duty instances and `discharges` (workflows §5.3) and
# the duty's attester, `due2:attestingParty` (workflows §5.3, due2-profiles §6).

ex:reportPolicy a odrl:Set ;
    odrl:profile <https://w3id.org/due2/profile#> ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:download .

ex:download a odrl:Permission ;
    odrl:assignee ex:Alice ;
    odrl:action ex:downloadReport ;
    odrl:target ex:MarketReport ;
    odrl:duty ex:payPerUse .

# One instance per request: a payment discharges one download, not all of them.
ex:payPerUse a odrl:Duty ;
    odrl:action ex:pay ;
    odrl:target ex:ReportFee ;
    # A duty that declares a function inherits no party (IM 2.6.5), so it states its assignee.
    odrl:assignee ex:Alice ;
    due2:attestingParty ex:Bank ;
    due2:instanceScope due2:grant .

# A collection, so that a branch of the bank (odrl:partOf in the SOTW closure) attests for it.
ex:Bank a odrl:PartyCollection .

# IM 2.4: an action other than use and transfer is included in exactly one other;
# the source names none for these, so odrl:use, the broadest.
ex:downloadReport a odrl:Action ; odrl:includedIn odrl:use .
ex:pay a odrl:Action ; odrl:includedIn odrl:use .
