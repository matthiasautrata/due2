@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ex:   <http://example.com/> .

# A negative case: a policy that names its replacement. ODRL IM §2.8: a
# processor MUST consider a policy with dct:isReplacedBy void, and MUST process
# the replacement instead. W1 does not fetch it; the policy store selects the
# replacement, so a replaced policy that reaches W1 is rejected.

ex:licence-v1 a odrl:Set ;
    dct:isReplacedBy ex:licence-v2 ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:read .

ex:read a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target ex:dataset ;
    odrl:assignee ex:alice .
