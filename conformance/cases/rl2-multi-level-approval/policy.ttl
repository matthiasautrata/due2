@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# Source: RL2 conformance/usecases/multi-level-approval.md

ex:analyticsAgreement a odrl:Agreement ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:conflict odrl:prohibit ;
    odrl:assigner ex:Bank ;
    odrl:assignee ex:Employee ;
    odrl:permission ex:approvedAccess .

ex:approvedAccess a odrl:Permission ;
    odrl:action ex:access ;
    odrl:target ex:CustomerTransactions ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:allApprovalsValid ;
        odrl:operator odrl:eq ;
        odrl:rightOperand true
    ] .

# IM 2.4: an action other than use and transfer is included in exactly one other;
# the source names none for these, so odrl:use, the broadest.
ex:access a odrl:Action ; odrl:includedIn odrl:use .

# RL2 path global.approvals.requiredSetValid: one boolean computed by the
# approval service (approvers, request binding, order, expiry).
ex:allApprovalsValid a odrl:LeftOperand ;
    dprod:operandSource dprod:stateSource ;
    dprod:operandProperty ex:requiredApprovalSetValid ;
    rdfs:range xsd:boolean .
