@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix due2:  <https://w3id.org/due2/profile#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .

# A negative case: valid ODRL 2.2, rejected by due2. The right operand has the
# shape of an xsd:dateTime but names no instant: February has no 30th (XSD 1.1
# Part 2 §3.3.7).

ex:licencePolicy a odrl:Set ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/>, <https://w3id.org/due2/profile#> ;
    odrl:conflict odrl:prohibit ;
    odrl:permission ex:display .

ex:display a odrl:Permission ;
    odrl:action odrl:display ;
    odrl:target ex:Report ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand odrl:dateTime ;
        odrl:operator odrl:lt ;
        odrl:rightOperand "2026-02-30T12:00:00Z"^^xsd:dateTime
    ] .
