@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .
@prefix offer: <https://example.org/offers/> .
@prefix agent: <https://example.org/agents/> .
@prefix asset: <https://example.org/assets/> .
@prefix rule:  <https://example.org/rules/> .

# Source: DPROD Contracts dprod-contracts/examples/baseline.ttl,
# policy <https://example.org/offers/country-ref> (EKGF dprod, develop, 50db943).

ex:country-ref-offer a dprod:DataOffer ;
    rdfs:label "Country Reference Data" ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:assigner agent:data-platform ;
    odrl:target asset:country-codes ;
    dprod:offerLifecycleStatus dprod:Active ;
    odrl:permission rule:ref-read, rule:ref-query ;
    odrl:prohibition rule:ref-no-modify .

rule:ref-read a odrl:Permission ;
    rdfs:label "Read access" ;
    odrl:action odrl:read .

rule:ref-query a odrl:Permission ;
    rdfs:label "Query access" ;
    odrl:action ex:query .

rule:ref-no-modify a odrl:Prohibition ;
    rdfs:label "No modification" ;
    odrl:action odrl:modify .

# --- domain vocabulary ---
ex:query a odrl:Action ;
    rdfs:label "query" ;
    odrl:includedIn odrl:read .

agent:data-platform a odrl:Party ; rdfs:label "Data Platform Team" .
asset:country-codes a odrl:Asset ; rdfs:label "Country Reference Table" .
