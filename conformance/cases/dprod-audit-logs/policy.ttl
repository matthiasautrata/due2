@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix dprod: <https://ekgf.org/dprod/spec/develop/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://example.org/> .
@prefix offer: <https://example.org/offers/> .
@prefix agent: <https://example.org/agents/> .
@prefix asset: <https://example.org/assets/> .
@prefix rule:  <https://example.org/rules/> .

# Source: DPROD Contracts dprod-contracts/examples/baseline.ttl,
# policy <https://example.org/offers/audit-logs> (EKGF dprod, develop, 50db943).

offer:audit-logs a dprod:DataOffer ;
    rdfs:label "Audit Log Archive" ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/> ;
    odrl:assigner agent:data-platform ;
    odrl:target asset:audit-logs ;

    odrl:permission rule:audit-read ;

    odrl:obligation rule:audit-retention ;

    odrl:prohibition rule:audit-no-modify ;
    odrl:prohibition rule:audit-no-export .

rule:audit-read a odrl:Permission ;
    rdfs:label "Compliance read access" ;
    odrl:action odrl:read ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand odrl:purpose ;
        odrl:operator odrl:eq ;
        odrl:rightOperand ex:compliance
    ] .

rule:audit-retention a odrl:Duty ;
    rdfs:label "7-year retention limit" ;
    odrl:action odrl:delete ;
    odrl:constraint [
        a odrl:Constraint ;
        odrl:leftOperand ex:retentionPeriod ;
        odrl:operator odrl:gt ;
        odrl:rightOperand "P7Y"^^xsd:duration
    ] .

rule:audit-no-modify a odrl:Prohibition ;
    rdfs:label "No modification" ;
    odrl:action odrl:modify .

rule:audit-no-export a odrl:Prohibition ;
    rdfs:label "No export" ;
    odrl:action ex:export .

# --- domain vocabulary (from the source file) ---
ex:export a odrl:Action ; rdfs:label "export" ; odrl:includedIn odrl:distribute .

ex:retentionPeriod a odrl:LeftOperand ;
    rdfs:label "retention period" ;
    dprod:operandSource dprod:requestSource ;
    dprod:operandProperty ex:retentionPeriod ;
    rdfs:range xsd:duration .

ex:compliance a ex:Purpose ; rdfs:label "compliance" .
ex:Purpose a rdfs:Class .

agent:data-platform a odrl:Party ; rdfs:label "Data Platform Team" .
asset:audit-logs a odrl:Asset ; rdfs:label "Audit Log Archive" .
