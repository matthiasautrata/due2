        "reference": "req-1", "action": "ex:startSession", "target": "ex:Application", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:LicensedUser" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:licenceActiveSeatCount": { "status": "resolved", "values": [ { "@value": "49", "@type": "xsd:integer" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "expected": { "verdict": "Permit", "frontier": [], "obligations": [], "why": "49 < 50 is T, so ex:seatAvailablePrivilege applies; 49 ≥ 50 is F, so the prohibition does not. The ready candidate gives Permit." },
      "rl2_expected": "Permit"
    },
    {
      "name": "50 active seats",
      "request": {
        "reference": "req-2", "action": "ex:startSession", "target": "ex:Application", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:LicensedUser" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:licenceActiveSeatCount": { "status": "resolved", "values": [ { "@value": "50", "@type": "xsd:integer" } ] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "expected": { "verdict": "Deny", "frontier": [], "obligations": [], "why": "50 ≥ 50 is T, so ex:capacityProhibition applies and survives; 50 < 50 is F. Deny." },
      "rl2_expected": "Deny"
    },
    {
      "name": "licence service unavailable",
      "request": {
        "reference": "req-3", "action": "ex:startSession", "target": "ex:Application", "at": "2026-06-01T00:00:00Z",
        "parties": { "odrl:assignee": "ex:LicensedUser" }, "params": {}
      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:licenceActiveSeatCount": { "status": "unresolved", "values": [] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "expected": { "verdict": "Indeterminate", "frontier": [], "obligations": [], "why": "Both rules are U. Most permissive completion (permission T, prohibition F): Permit. Most restrictive (permission F, prohibition T): Deny. They differ." }
    },
    {
      "name": "seat count of the wrong type",
      "request": {
        "reference": "req-4", "action": "ex:startSession", "target": "ex:Application", "at": "2026-06-01T00:00:00Z",
