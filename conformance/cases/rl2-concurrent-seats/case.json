      },
      "sotw": {
        "effective_at": "2026-06-01T00:00:00Z",
        "facts": { "ex:licenceActiveSeatCount": { "status": "invalid", "values": [] } },
        "evidence": [], "activation": {}, "closure": []
      },
      "expected": { "verdict": "Indeterminate", "frontier": [], "obligations": [], "why": "The source supplied a value not conforming to xsd:integer, so the property is invalid and both constraints are U, never F. Completions give Permit and Deny." }
