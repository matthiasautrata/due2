@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Source: DIPS-Tools/ODRL-Engine@ee72ffc test_cases/validation/invalid_ODRL/refinement_instead_of_constraint2.ttl
# (MIT, University of Southampton). Rules named; conflict and profiles
# declared; the right operand typed. The refinement's place is as authored: a
# negative case.

# The odrl:refinement sits on the Policy.
<http://example.com/policy:1010> a odrl:Set ;
    odrl:profile <https://ekgf.org/dprod/spec/develop/>, <https://w3id.org/due2/profile#> ;
    odrl:conflict odrl:prohibit ;
    odrl:refinement [
        a odrl:Constraint ;
        odrl:leftOperand odrl:payAmount ;
        odrl:operator odrl:eq ;
        odrl:rightOperand "5.0"^^xsd:decimal ;
        odrl:unit <http://dbpedia.org/resource/Euro>
    ] ;
    odrl:permission <http://example.com/policy:1010#use> .

<http://example.com/policy:1010#use> a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target <http://example.com/asset:9898.movie> ;
    odrl:duty <http://example.com/policy:1010#use-other> .

<http://example.com/policy:1010#use-other> a odrl:Duty ;
    odrl:action odrl:use ;
    odrl:target <http://example.com/asset:1234.movie> .
